{
  "manifest_version": 3,
  "name": "Iris for YouTube",
  "version": "1.0.0",
  "description": "Send YouTube videos to friends, and see what they sent you, right inside YouTube.",
  "browser_specific_settings": {
    "gecko": {
      "id": "iris@nick.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "personallyIdentifyingInfo", "personalCommunications", "websiteActivity"]
      }
    }
  },
  "icons": {
    "16": "icons/iris-16.png",
    "32": "icons/iris-32.png",
    "48": "icons/iris-48.png",
    "96": "icons/iris-96.png",
    "128": "icons/iris-128.png"
  },
  "action": {
    "default_title": "Iris",
    "default_icon": {
      "16": "icons/iris-16.png",
      "32": "icons/iris-32.png"
    },
    "theme_icons": [
      { "light": "icons/iris-light-16.png", "dark": "icons/iris-16.png", "size": 16 },
      { "light": "icons/iris-light-32.png", "dark": "icons/iris-32.png", "size": 32 }
    ]
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["identity", "storage", "menus", "alarms"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.supabase.co/*"
  ]
}
