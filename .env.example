# Copy to .env (see SETUP.md).
# Local stack: the API URL and anon/publishable key printed by `npx supabase start`.
# Hosted: Supabase → Project Settings → API.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon / publishable key>

# Read by the Supabase CLI for supabase/config.toml (local stack only).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google oauth client id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<google oauth client secret>

# AMO API credentials for `npm run sign` (https://addons.mozilla.org/developers/addon/api/key/).
WEB_EXT_API_KEY=user:00000000:000
WEB_EXT_API_SECRET=<jwt secret>
